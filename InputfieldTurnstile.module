<?php namespace ProcessWire;

/**
 * Cloudflare Turnstile Inputfield
 * 
 * @property string $turnstileSiteKey
 * @property string $turnstileTheme
 * @property string $turnstileAppearance
 * @property string $turnstileSize
 * 
 */
class InputfieldTurnstile extends Inputfield {

	public static function getModuleInfo(): array {
		return array(
			'title' => 'Turnstile (Cloudflare)',
			'version' => 2,
			'summary' => 'Adds a Cloudflare Turnstile input, preventing submission until user successfully completes it.',
			'icon' => 'shield',
			'requires' => array('ProcessWire>=3.0', 'MarkupCloudflareTurnstile'),
		);
	}

	public function __construct() {
		parent::__construct();
		// Defaults will be populated from InputfieldTurnstileConfig
	}

	protected function turnstileLabel(): string {
		return 'Turnstile';
	}

	protected function missingKeysLabel(): string {
		return $this->_('Missing API key(s)');
	}

	public function error($text, $flags = 0) {
		$text = $this->turnstileLabel() . ' - ' . $text;
		return parent::error($text, $flags);
	}

	public function ___renderScript(): string {
		$url = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
		return "<script src='$url' async defer></script>";
	}

	public function setParent(InputfieldWrapper $parent) {
		parent::setParent($parent);
		$form = $this->getRootParent();
		$markup =
			"<noscript><p class='ui-state-error-text'>" . 
			$this->_('ERROR: Javascript is required to submit this form, please enable it and reload this page before continuing.') .
			"</p></noscript>";
		
		if($form && isset($form->prependMarkup) && strpos($form->prependMarkup, '<noscript>') === false) {
			$form->prependMarkup .= $markup;
		}
		return $this;
	}

	public function renderReady(?Inputfield $parent = null, $renderValueMode = false): bool {
		$this->skipLabel = Inputfield::skipLabelHeader;
		return parent::renderReady($parent, $renderValueMode);
	}

	public function ___render(): string {
		$markup = $this->wire('modules')->get('MarkupCloudflareTurnstile');
		
		// Prepare attributes for the Markup module
		$attrs = $this->getAttributes();
		$attrs['class'] = trim('cf-turnstile ' . ($attrs['class'] ?? ''));
		$attrs['data-size'] = $this->turnstileSize ?: 'normal';
		$attrs['data-theme'] = $this->turnstileTheme ?: 'auto';
		$attrs['data-appearance'] = $this->turnstileAppearance === 'interaction-only' ? 'interaction-only' : 'always';
		
		// If a specific site key is set on this inputfield, override the Markup module's default
		if($this->turnstileSiteKey) {
			$attrs['data-sitekey'] = $this->turnstileSiteKey;
		}

		// Render using the Markup module
		return $markup->render($attrs) . $markup->getScript();
	}

	public function ___processInput(WireInputData $input) {
		$markup = $this->wire('modules')->get('MarkupCloudflareTurnstile');
		// Markup module handles getting the response from POST internally usually, 
		// or checks 'cf-turnstile-response'
		if($markup->verifyResponse() === true) {
			$this->val($this->_('Ok'));
		} else {
			$this->error($this->_('Failed to validate (Turnstile)'));
		}
		return $this;
	}

	public function ___getConfigInputfields(): InputfieldWrapper {
		$inputfields = parent::___getConfigInputfields();
		$modules = $this->wire('modules');

		$f = $modules->get('InputfieldRadios');
		$f->attr('name', 'turnstileAppearance');
		$f->label = $this->_('Appearance');
		$f->description = $this->_('With a Managed widget, show it always or only when visitor interaction is needed. Both options use the same API keys.');
		$f->addOption('always', $this->_('Always visible'));
		$f->addOption('interaction-only', $this->_('Only when interaction is needed'));
		$f->attr('value', $this->turnstileAppearance === 'interaction-only' ? 'interaction-only' : 'always');
		$f->optionColumns = 1;
		$inputfields->add($f);

		/** @var InputfieldRadios $f */
		$f = $modules->get('InputfieldRadios');
		$f->attr('name', 'turnstileTheme'); 
		$f->label = $this->_('Theme'); 
		$f->addOption('auto', $this->_('Auto'));
		$f->addOption('light', $this->_('Light'));
		$f->addOption('dark', $this->_('Dark')); 
		$f->attr('value', $this->turnstileTheme ?: 'auto'); 
		$f->optionColumns = 1;
		$inputfields->add($f);

		/** @var InputfieldRadios $f */
		$f = $modules->get('InputfieldRadios');
		$f->attr('name', 'turnstileSize'); 
		$f->label = $this->_('Size'); 
		$f->addOption('normal', $this->_('Normal'));
		$f->addOption('compact', $this->_('Compact'));
		$f->addOption('flexible', $this->_('Flexible'));
		$f->attr('value', $this->turnstileSize ?: 'normal'); 
		$f->optionColumns = 1;
		$inputfields->add($f);
		
		return $inputfields;	
	}
}
